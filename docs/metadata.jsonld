    {
      "@type": "ItemList",
      "@id": "https://stopapr.github.io/Palestine-Solidarity-Campaign-AGM-2026-Resolution-9-Examples-of-Anti-Palestinian-Racism-/#examples-list",
      "name": "The 18 PSC-adopted examples of Anti-Palestinian Racism",
      "numberOfItems": 18,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "isBasedOn": {
        "@id": "https://stopapr.github.io/Palestine-Solidarity-Campaign-AGM-2026-Resolution-9-Examples-of-Anti-Palestinian-Racism-/#motion9"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Using the phrase ‘a land without people for a people without a land’ to deny Palestinian indigeneity in historic Palestine."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Denying the Nakba."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Failing to acknowledge Palestinians as an indigenous people with a collective identity, belonging, and rights in historic Palestine."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Erasing Palestinians’ human rights, equal dignity, and worth."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Defaming Palestinians or their allies as inherently antisemitic, a terrorist threat or sympathisers, or opposed to democratic values."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Justifying violence against Palestinians."
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "Requiring Palestinians or supporters to denounce acts more vociferously or holding them collectively responsible for others’ acts."
        },
        {
          "@type": "ListItem",
          "position": 8,
          "name": "Excluding Palestinian perspectives, Palestinians, or their allies, or pressuring others to do so."
        },
        {
          "@type": "ListItem",
          "position": 9,
          "name": "Politicians and officials failing to engage with Palestinian victims of war crimes or racism while engaging with other racial groups."
        },
        {
          "@type": "ListItem",
          "position": 10,
          "name": "Denying, delaying, or undermining recognition of Palestine as a state while supporting recognition of Israel."
        },
        {
          "@type": "ListItem",
          "position": 11,
          "name": "Calling for a safe and secure Israel but not for Palestinian safety and security."
        },
        {
          "@type": "ListItem",
          "position": 12,
          "name": "Denying Palestinian refugees and their descendants the right of return under international law."
        },
        {
          "@type": "ListItem",
          "position": 13,
          "name": "Not applying the same international law standards to Palestinians as to other groups."
        },
        {
          "@type": "ListItem",
          "position": 14,
          "name": "The systems of apartheid imposed on Palestinians, supporting these systems, or denying or minimising their existence against the overwhelming evidence."
        },
        {
          "@type": "ListItem",
          "position": 15,
          "name": "Promoting or excusing extremist settler ideology, including hate or violence towards Palestinians, discriminatory laws, or theft of Palestinian land and resources."
        },
        {
          "@type": "ListItem",
          "position": 16,
          "name": "The Balfour Declaration, by privileging one group on a religious basis, caused lasting harm to indigenous Palestinians by denying their rights and enabling colonisation."
        },
        {
          "@type": "ListItem",
          "position": 17,
          "name": "Islamophobia and hatred targeting Palestinian Muslims, non-Muslim Palestinians perceived as Muslim, and other Muslims supporting Palestinian rights."
        },
        {
          "@type": "ListItem",
          "position": 18,
          "name": "Targeting, vilifying, or penalising individuals for expressing solidarity with Palestinians, including treating support for Palestinian rights as suspect, extremist, or antisemitic by association."
        }
      ]
    },
